# No trailing slash: a slash matches a directory only, and this repo once
# committed a `node_modules` *symlink* (a worktree pointing at the main
# checkout) straight past the ignore rule.
node_modules
*.log
.DS_Store

# scratch copies the refresh e2e test edits while it runs
test/fixtures/refresh-run-*/

# framed screenshots are machine-specific (they capture the local WM's
# decorations), so they are generated on demand rather than committed
docs/img/framed/
